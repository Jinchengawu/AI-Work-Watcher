{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Water Weekly Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "scores", "recommendations", "cross_project_patterns"],
  "properties": {
    "summary": {"type": "string", "maxLength": 3000},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_correctness", "verification_discipline", "flow_efficiency", "rework", "resource_cost", "safety"],
      "properties": {
        "delivery_correctness": {"$ref": "#/$defs/score"},
        "verification_discipline": {"$ref": "#/$defs/score"},
        "flow_efficiency": {"$ref": "#/$defs/score"},
        "rework": {"$ref": "#/$defs/score"},
        "resource_cost": {"$ref": "#/$defs/score"},
        "safety": {"$ref": "#/$defs/score"}
      }
    },
    "recommendations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/recommendation"}},
    "cross_project_patterns": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 500}}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "evidence_ids", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "maxItems": 20},
        "rationale": {"type": "string", "maxLength": 1000}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "scope", "category", "evidence_ids", "diagnosis", "proposed_change", "expected_effect", "impact", "confidence", "effort", "validation_metric", "rollback_condition"],
      "properties": {
        "title": {"type": "string", "maxLength": 200},
        "scope": {
          "type": "string",
          "pattern": "^(global|project:[a-z0-9-]{1,80}|terminal:(codex|claude)|model:[A-Za-z0-9._-]{1,100})$"
        },
        "category": {"type": "string", "maxLength": 100},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string"}},
        "diagnosis": {"type": "string", "maxLength": 1500},
        "proposed_change": {"type": "string", "maxLength": 3000},
        "expected_effect": {"type": "string", "maxLength": 1000},
        "impact": {"type": "string", "enum": ["low", "medium", "high"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "effort": {"type": "string", "enum": ["low", "medium", "high"]},
        "validation_metric": {"type": "string", "maxLength": 1000},
        "rollback_condition": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
